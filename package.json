{
  "name": "@yourorg/dominion",
  "version": "0.1.0",
  "description": "DOMinion: AI-driven Playwright test authoring. Crawl a site or describe a flow, review the plan, and get verified, runnable Playwright tests committed to your repo.",
  "type": "module",
  "license": "UNLICENSED",
  "keywords": [
    "playwright",
    "testing",
    "e2e",
    "ai",
    "claude",
    "test-generation"
  ],
  "bin": {
    "dominion": "dist/cli/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./setup": {
      "import": {
        "types": "./dist/setup.d.ts",
        "default": "./dist/setup.js"
      },
      "require": {
        "types": "./dist/setup.d.cts",
        "default": "./dist/setup.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "templates",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build:lib && npm run build:ui",
    "build:lib": "tsup",
    "build:ui": "vite build --config src/ui/vite.config.ts",
    "dev:ui": "vite --config src/ui/vite.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:e2e": "vitest run --project e2e",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.56"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.322",
    "@anthropic-ai/sdk": "1.8.0",
    "@fastify/static": "10.1.10",
    "@fastify/websocket": "11.3.7",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@playwright/mcp": "0.0.84",
    "commander": "14.0.3",
    "dotenv": "18.0.10",
    "fastify": "5.12.8",
    "jiti": "2.7.0",
    "otplib": "13.6.0",
    "ts-morph": "28.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@yourorg/dominion": "file:../dominion-dist/yourorg-dominion-0.1.0.tgz",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsup": "9.0.0",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
